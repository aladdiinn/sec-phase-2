# ─── SecurePulse Environment Variables ───────────────────────────────────────
# PostgreSQL Version | Phase 2 Complete

# ─── Flask ────────────────────────────────────────────────────────────────────
SECRET_KEY=3f8a21c7b9d04e6f1a5c8b2d9e7f3041a6b8c2d5e9f1a3c7b0d4e6f2a8c1b5d
DEBUG=true
PORT=5001

# ─── PostgreSQL (LOCAL DEVELOPMENT) ───────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://securepulse:securepulse_pass@127.0.0.1:5432/securepulse_db

# ─── Auth ─────────────────────────────────────────────────────────────────────
DEFAULT_ADMIN_EMAIL=admin@securepulse.local
DEFAULT_ADMIN_PASSWORD=Admin@1234

# ─── Agent API Key ────────────────────────────────────────────────────────────
AGENT_API_KEY=sp-agent-key-9f2a8c1b5d3e7f0a4c6b8d2e1f5a9c3b

# ─── Monitoring ───────────────────────────────────────────────────────────────
HEARTBEAT_TIMEOUT=120

# ─── Phase 2: Optional External Integrations ──────────────────────────────────
# Uncomment and fill in if you have these services configured

# Okta (for real account disable)
# OKTA_DOMAIN=your-org.okta.com
# OKTA_API_TOKEN=xxxxx_your_token_xxxxx

# Azure AD (alternative to Okta)
# AZURE_TENANT_ID=xxxxx
# AZURE_CLIENT_ID=xxxxx
# AZURE_CLIENT_SECRET=xxxxx

# Jira Cloud (for real ticket creation)
# JIRA_BASE_URL=https://your-company.atlassian.net
# JIRA_API_TOKEN=xxxxx_your_token_xxxxx
# JIRA_USER_EMAIL=your-email@company.com
# JIRA_PROJECT_KEY=SEC

# Firewall APIs (optional)
# PFSENSE_ENDPOINT=https://your-firewall/api/
# PFSENSE_API_TOKEN=xxxxx

# AWS WAF (optional)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=xxxxx
# AWS_SECRET_ACCESS_KEY=xxxxx
# AWS_SECURITY_GROUP_ID=sg-xxxxx